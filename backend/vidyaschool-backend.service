[Unit]
Description=VidyaSchool FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/vs/backend
# Activate venv and run uvicorn
ExecStart=/home/ubuntu/vs/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Load .env file
EnvironmentFile=/home/ubuntu/vs/backend/.env

[Install]
WantedBy=multi-user.target
